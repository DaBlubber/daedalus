# Secrets and switches for Daedalus. Copy to .env - never commit the real file.

# Docker Compose (deploy/docker-compose.yml) builds the connection from this
# password and its own PostgreSQL container.
POSTGRES_PASSWORD=change-me

# Any other deployment: the PostgreSQL connection for collector AND web UI. The
# schema `daedalus` is created on the first start of the collector.
DAEDALUS_DSN=postgresql://daedalus:change-me@db:5432/daedalus

# SNMP v2c read communities
DAEDALUS_SNMP_FIREWALL=public
DAEDALUS_SNMP_SWITCH=public

# Where the site configuration lives (inside the container)
DAEDALUS_CONFIG=/config/daedalus.toml

# Optional: allow the port scan in the UI (nmap connect scan, top 100 ports).
# Leave off unless your firewall's intrusion prevention has an exception for the
# host running Daedalus - otherwise that host may get blocked.
DAEDALUS_SCAN_ENABLED=no

# Optional, development only: run SNMP on another host over SSH
# DAEDALUS_SNMP_VIA=build-host.example.com

# Only for the test suite - the database name MUST end in _test, it gets emptied.
# DAEDALUS_TEST_DSN=postgresql://daedalus:change-me@localhost:5432/daedalus_test
